    "mainEntity": [
      {
        "@type": "Question",
        "name": "Если я перевёл предоплату, значит, согласился со всеми правилами?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Не обязательно. Оплата может считаться согласием, если условия были доступны вам до перевода. Если правила показали только после оплаты, ситуация другая."
        }
      },
      {
        "@type": "Question",
        "name": "Можно передать код от квартиры другу или коллеге?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Сначала проверьте правила. Во многих объектах передавать ключи и коды третьим лицам нельзя."
        }
      },
      {
        "@type": "Question",
        "name": "Ранний заезд можно считать включённым?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Нет. Его лучше согласовать заранее и сохранить договорённость в переписке."
        }
      },
      {
        "@type": "Question",
        "name": "Когда вернут обеспечительный платёж?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Это зависит от условий брони: заранее посмотрите сумму, срок возврата и причины возможного удержания."
        }
      }
