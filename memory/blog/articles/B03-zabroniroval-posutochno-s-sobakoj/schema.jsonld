  "mainEntity": {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Собака маленькая и в переноске — это считается животным?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Считается. Для правил проживания важен факт животного в квартире, а не размер. Переноска помогает в разговоре, но не заменяет разрешение — спрашивайте всё равно."
        }
      },
      {
        "@type": "Question",
        "name": "Хозяин разрешил в чате, а в правилах написано «без животных». Что важнее?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Практически важно письменное подтверждение от того, кто сдаёт квартиру. Скриншот переписки превращает спор в понятный факт. Идеально — фраза в чате: «Для вашей брони проживание с собакой согласовано»."
        }
      },
      {
        "@type": "Question",
        "name": "Можно ли оставить собаку одну в квартире?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Это отдельное условие — спрашивайте отдельно. Часто разрешают проживание, но просят не оставлять животное одно из-за лая и соседей."
        }
      }
    ]
  }
