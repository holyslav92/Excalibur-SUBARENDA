      "@type": "FAQPage",
      "@id": "{{SITE_BASE}}/blog/privez-syna-v-vuz-kvartira-posutochno-ryadom-40-minut-peshkom/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Мы едем на две ночи. Стоит ли вообще заморачиваться с маршрутом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Особенно стоит. На две ночи нет запасного дня. Одно опоздание — и переносить некуда."
          }
        },
        {
          "@type": "Question",
          "name": "Хозяин пишет «5 минут до университета». Верить?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проверить. Откройте карту и постройте маршрут от адреса квартиры до адреса вашего корпуса. Тридцать секунд — и вопрос закрыт."
          }
        },
        {
          "@type": "Question",
          "name": "А если нужный корпус только уточняется?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Тогда ориентируйтесь на приёмную комиссию и центр. Адреса приёма документов и расписание лучше смотреть на официальных страницах: порядок приёма документов ТюмГУ и информация ТИУ по заселению в общежитие."
          }
        },
        {
          "@type": "Question",
          "name": "Общежитие дадут — квартира не нужна?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Часто так и есть. Но заселение идёт волнами с 28 августа, и между приездом и ключом от комнаты иногда остаётся пара суток."
          }
        },
        {
          "@type": "Question",
          "name": "Можно продлить, если общежитие задержится?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Спрашивайте при бронировании, а не в последний вечер. Мы отвечаем по конкретным датам, наличие всегда подтверждаем отдельно."
          }
        }
      ]
