{
  "catalog_id": "meme-top100-v2",
  "status": "ok",
  "updated_at": "2026-08-31",
  "sources": [
    "Know Your Meme Meme of the Year 2025 top 20 (knowyourmeme.com/editorials/poll/meme-of-the-year-the-top-20-memes-of-2025)",
    "Rolling Stone 25 Best Memes of 2025",
    "Classic internet meme templates (Roll Safe, Pepe, Wojak, Drake, etc.)",
    "Russian meme canon: sacrednik/priest, Жириновский, etc."
  ],
  "usage_rules": {
    "cover": "REQUIRED exactly ONE named catalog entry on every cover as die-cut sticker graphic. Pick by topic-tag overlap (scripts/excalibur_blog_meme_rotate.py); skip ids in last 8 live covers (memory/cover/meme-used.json). Prefer non-cat people-memes on cover. Cat-meme on cover counts toward max 1 cat/article across cover+7 inlines.",
    "inline": "NO large human ever. Meme stickers only: max 15% frame area, corner/edge accent, never co-host/presenter slot. Prefer people-memes; cat-meme only if article's single cat slot.",
    "cat_meme_quota": {
      "max_slots_per_article": 1,
      "scope": "cover + inline_1..inline_7",
      "anti_repeat_family": "__cat_meme_family__",
      "rotate_non_cat": "Roll Safe, Harold, Pepe, Wojak, Gigachad, sacrednik, Жириновский, etc.",
      "forbidden_cat_repeats": [
        "grumpy cat",
        "tardar sauce",
        "ginger cat",
        "smudge cat",
        "tabby repeat"
      ]
    },
    "forbidden": [
      "invented photogenic stranger",
      "AI-generated original face called meme",
      "stock model / handsome realtor",
      "meme person >15% frame on inline",
      "meme person in left portrait or pointing-at-table presenter role on inline"
    ],
    "sticker_scale_max": 0.15,
    "sticker_scale_recommended": 0.08,
    "rotation": {
      "pick_by": "topic_tag_overlap_with_article",
      "skip_last_n_covers": 8,
      "used_log": "memory/cover/meme-used.json",
      "picker_script": "scripts/excalibur_blog_meme_rotate.py",
      "never_same_face_twice_in_window": true,
      "prefer_asset_file": "memory/cover/memes/<id>.png when present"
    }
  },
  "banned_celebrity_templates": [
    "Salt Bae",
    "Drake Hotline Bling two-panel",
    "Distracted Boyfriend actors by name"
  ],
