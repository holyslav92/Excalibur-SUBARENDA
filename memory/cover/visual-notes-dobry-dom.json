{
  "tenant": "dobry-dom",
  "status": "locked",
  "label_ru": "Добрый дом — WOW poster cover + factory logo paste",
  "canon_files": [
    "memory/cover/cover-canon.json",
    "memory/cover/cover-design-code.json",
    "shared/tenant-config.json",
    "shared/blog-cover-quad-canvas-contract.md"
  ],
  "wow_cover_rules": {
    "forbid_wordpress_ui_in_art": {
      "required": true,
      "cover_qa_check": "forbid_wordpress_ui_in_art",
      "forbidden_tokens": [
        "WordPress",
        "Gutenberg",
        "Add title",
        "Publish",
        "Dashboard",
        "wp-admin",
        "block editor",
        "theme chrome",
        "cookie bar",
        "cookie banner"
      ],
      "note": "Generated art must never look like a CMS screenshot or admin UI."
    },
    "no_element_overlap": {
      "required": true,
      "cover_qa_check": "no_element_overlap",
      "elements": [
        "headline",
        "wordstat_stickers",
        "meme_sticker",
        "cat_sticker",
        "phone_cta",
        "people",
        "logo_pad"
      ],
      "logo_pad": {
        "corner": "top_right",
        "reserved_empty_in_generation": true,
        "factory_paste_only": true,
        "asset": "memory/cover/assets/brand/logo-dobry-dom.png",
        "width_fraction": "8-12%",
        "forbid_phone_in_pad": true
      },
      "phone_on_cover_only": {
        "display": "+7 (993) 574-83-22",
        "placement": "bottom_left_post_composite",
        "forbidden_in_logo_pad": true
      },
      "note": "Headline, stickers, meme, cat, phone, people, logo never sit on each other."
    },
    "wow_poster": {
      "required": true,
      "cover_qa_check": "wow_poster_magazine_typography",
      "must": [
        "magazine cover poster composition",
        "beautiful readable Russian display type for hook",
        "one sharp scene line + props",
        "high-key editorial collage"
      ],
      "forbidden": [
        "timid system font",
        "wall of tiny labels",
        "empty stock photo",
        "wordpress screenshot",
        "doc-only office hero"
      ]
    },
    "inline_logo": {
      "required": true,
      "cover_qa_checks": [
        "inline_logo_count_2_3",
        "forbid_multiple_logos_per_image",
        "logo_top_right_fixed"
      ],
      "count_min": 2,
      "count_max": 3,
      "default_slots": ["inline_1", "inline_3", "inline_7"],
      "corner": "top_right",
      "same_pad_as_cover": true,
      "forbid_two_plus_logos_per_frame": true
    }
  },
  "tenant_scope": "holyslav92/Excalibur-SUBARENDA — Добрый дом / добрыйдом-72.рф ONLY. Never tymenrieltor.ru / Excalibur-2-Cloud rieltor canon."
}
