# Cursor Cloud / self-hosted worker — Excalibur-SUBARENDA (Добрый дом)
CURSOR_API_KEY=

# Public site (punycode canon for env; unicode: добрыйдом-72.рф)
PUBLIC_SITE_URL=https://xn---72-9cdob8azaodt6k.xn--p1ai
WP_SITE_URL=https://xn---72-9cdob8azaodt6k.xn--p1ai
WP_ADMIN_URL=https://xn---72-9cdob8azaodt6k.xn--p1ai/wp-admin/

# Excalibur BLOG publish — default OFF (same safety as Excalibur-2-Cloud)
EXCALIBUR_BLOG_ALLOW_PUBLISH=no
EXCALIBUR_TOPIC_ID=
EXCALIBUR_PROJECT_ROOT=

# ---------------------------------------------------------------------------
# SFTP publish credentials (FTP_* names = same SFTP account)
# Transport is ALWAYS SFTP/SSH on port 22 — never plain FTP upload.
# Set Добрый дом WP credentials in Cursor Cloud Secrets — NOT from The Риэлтор.
# ---------------------------------------------------------------------------
FTP_HOST=
FTP_USER=
FTP_PASS=
# Alias used by some Cloud providers:
# FTP_PASSWORD=
# SFTP login cwd where wp-load.php lives (canon). Empty or "/" also → "."
FTP_ROOT=.

# Optional SSH_* aliases (same values as FTP_* if you prefer SSH_ names)
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_PASS=
# SSH_PASSWORD=
# SSH_ROOT=.

# MCP-KV (PRIMARY for Wordstat in Cloud Agents) — optional Cloud Secret, never commit value
MCP_KV_TOKEN=

# Optional direct Yandex Wordstat API fallback (secondary to MCP-KV)
WORDSTAT_API_KEY=
WORDSTAT_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Yandex Metrica Reports API (content learning / site feedback)
# Docs: https://yandex.ru/dev/metrika/  scope: metrika:read
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# Optional search-performance loop (read-only; separate from Metrika behavior)
# YANDEX_WEBMASTER_OAUTH_TOKEN=
# YANDEX_WEBMASTER_HOST_ID=
