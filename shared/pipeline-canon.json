{
  "version": "human-first-v2",
  "description": "Research → Title → Writer(meaning) → Sol(style) → Description → Cover||Schema → Cover-QA → Indexer → Publish",
  "pipeline_agents_count": 18,
  "pipeline_agents": [
    "excalibur-blog-setup",
    "excalibur-blog-setup-voice",
    "excalibur-blog-setup-visual",
    "excalibur-blog-director",
    "excalibur-blog-scout",
    "excalibur-blog-research",
    "excalibur-blog-title",
    "excalibur-blog-writer",
    "excalibur-blog-sol",
    "excalibur-blog-description",
    "excalibur-blog-cover-text",
    "excalibur-blog-schema",
    "excalibur-blog-cover",
    "excalibur-blog-cover-qa",
    "excalibur-blog-indexer",
    "excalibur-blog-publish",
    "excalibur-blog-fixer",
    "excalibur-blog-content-learner"
  ],
  "description_agent": "excalibur-blog-description",
  "description_output": "description-brief.json",
  "description_rules": "shared/dzen-description-rules.md",
  "cover_qa_agent": "excalibur-blog-cover-qa",
  "cover_qa_output": "cover/cover_qa.json",
  "writer_allowed_sources": [
    "shared/writer-master-prompt.md",
    "research-notes.md",
    "title-brief.json",
    "published-titles-only.md",
    "shared/dzen-content-rules.md",
    "shared/rf-blocked-entities.json"
  ],
  "writer_is_final": false,
  "writer_writes_opening": true,
  "writer_output": "drafts/writer.html",
  "writer_forbidden_sources": [
    "memory/blog/articles/*/article.html",
    "published site articles (live pages — old site text is a bad exemplar)",
    "memory/topics/",
    "memory/topics/blog-topics.md",
    "memory/content-lessons.md",
    "shared/golden-benchmark",
    "QA reports",
    "neighbor research-notes as prose exemplars"
  ],
  "sol_agent": "excalibur-blog-sol",
  "sol_is_final": true,
  "sol_output": "article.html",
  "sol_allowed_sources": [
    "shared/SOUL.md",
    "shared/soul-examples/SOURCE.md",
    "shared/soul-examples/post-to-article.md",
    "shared/soul-examples/good-outputs.md",
    "shared/soul-examples/bad-outputs.md",
    "shared/article-style.md",
    "drafts/writer.html",
    "title-brief.json",
    "research-notes.md"
  ],
  "sol_forbidden_sources": [
    "memory/blog/articles/*/article.html (neighbors)",
    "published site articles",
    "memory/topics/",
    "memory/content-lessons.md",
    "Foreign channel posts as style exemplars (use only tenant SOUL examples)"
  ],
  "required_article_meta": {
    "pipeline_canon": "human-first-v2",
    "editorial_swarm": false
  },
  "forbidden_article_files": [
    "critic-skip.json",
    "critic-report.json",
    "critic-report-gate.json",
    "glavred-skip.json",
    "glavred-gate.json",
    "reader-panel-gate.json",
    "reader-sim-report.json",
    "reader-sim-gate.json",
    "novice-walkthrough.json",
    "novice-dry-run-report.json",
    "visual-qa-skip.json",
    "visual-qa-report.json",
    "thesis-brief.json",
    "thesis-brief-gate.json",
    "headline-board.json",
    "headline-board-gate.json",
    "anti-template-notes.json",
    "anti-template-report.json",
    "human-voice-lint.json",
    "utility-lint-report.json"
  ],
  "forbidden_body_markers": [
    "day-1",
    "day one",
    "day 1",
    "first win",
    "quick win"
  ],
  "forbidden_title_markers": [
    "без копипаста за вечер",
    "без копипаста",
    "за один вечер",
    "за вечер",
    "группа без копипаста",
    "канал без копипаста",
    "полный гайд",
    "что такое",
    "и как"
  ],
  "opening_rules": {
    "block_first": true,
    "writer_owns_opening": false,
    "sol_owns_opening": true,
    "no_term_dump": true,
    "no_research_brief": true,
    "no_api_calque_styk": true,
    "style": "shared/article-style.md",
    "soul": "shared/SOUL.md",
    "soul_examples": "shared/soul-examples/",
    "gate": "scripts/excalibur_blog_opening_meta_gate.py"
  },
  "h1_rules": {
    "no_series_templates": true,
    "max_len": 70,
    "style": "shared/article-style.md",
    "soul": "shared/SOUL.md"
  }
}
